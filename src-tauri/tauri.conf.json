{
  "build": {
    "distDir": "../dist",
    "devPath": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "StickyNotes",
    "version": "1.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "all": false, "open": true, "save": true }
    },
    "bundle": {
      "active": false,
      "identifier": "com.stickynotes.app",
      "icon": ["icons/icon.ico"]
    },
    "security": { "csp": null },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "title": "StickyNotes",
        "width": 420,
        "height": 540,
        "minWidth": 280,
        "minHeight": 360,
        "alwaysOnTop": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
